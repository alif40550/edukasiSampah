# Database MySQL Production / Staging
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=edukasi_sampah

# Optional: Google OAuth Client ID (Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin Dashboard Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat_di_production
ADMIN_SECRET_TOKEN=buat_random_secret_string_panjang_minimal_32_karakter
